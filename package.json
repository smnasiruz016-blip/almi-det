{
  "name": "almi-det",
  "version": "0.1.0",
  "private": true,
  "description": "AlmiDET — AI-powered Duolingo English Test practice (10–160 scale, four subscores) in the AlmiWorld family. Separate product (almidet.almiworld.com). Original content — never copied from Duolingo.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run gate:all && prisma migrate deploy && next build",
    "start": "next start",
    "gate:all": "tsx scripts/gates/all.mts",
    "gate:one": "tsx scripts/gates/all.mts",
    "gate:min-items": "tsx scripts/gates/all.mts --only=min-items",
    "gate:leak": "tsx scripts/gates/all.mts --only=leak",
    "gate:degame": "tsx scripts/gates/all.mts --only=degame",
    "gate:cloze": "tsx scripts/gates/all.mts --only=cloze",
    "gate:reading-set": "tsx scripts/gates/all.mts --only=reading-set",
    "gate:key-typable": "tsx scripts/gates/all.mts --only=key-typable",
    "gate:uniformity": "tsx scripts/gates/all.mts --only=uniformity",
    "gate:il-leak": "tsx scripts/gates/all.mts --only=il-leak",
    "gate:il-options": "tsx scripts/gates/all.mts --only=il-options",
    "gate:il-cloze-audio": "tsx scripts/gates/all.mts --only=il-cloze-audio",
    "gate:il-audio-coverage": "tsx scripts/gates/all.mts --only=il-audio-coverage",
    "gate:writing-leak": "tsx scripts/gates/all.mts --only=writing-leak",
    "gate:writing-prompts": "tsx scripts/gates/all.mts --only=writing-prompts",
    "gate:runtime": "tsx scripts/gates/runtime-probe.mts",
    "gate:fixtures": "tsx scripts/gates/fixtures/make.mts",
    "audio:render": "tsx --env-file=.env.local scripts/generate-det-audio.mts",
    "postinstall": "prisma generate",
    "seed:read-select": "tsx scripts/seed/read-and-select.ts",
    "seed:listen": "tsx scripts/seed/listen-and-type.ts",
    "seed:write-photo": "tsx scripts/seed/write-about-photo.ts",
    "seed:read-complete": "tsx scripts/seed/read-and-complete.ts",
    "seed:interactive-reading": "tsx scripts/seed/interactive-reading.ts",
    "seed:fill-blanks": "tsx scripts/seed/fill-in-the-blanks.ts",
    "seed:interactive-listening": "tsx scripts/seed/interactive-listening.ts",
    "seed:il-check": "tsx scripts/seed/il-data-check.mts",
    "seed:speak": "tsx scripts/seed/speak-about-photo.ts",
    "seed:interactive-writing": "tsx scripts/seed/interactive-writing.ts",
    "seed:writing-sample": "tsx scripts/seed/writing-sample.ts",
    "seed:all": "npm run seed:read-select && npm run seed:listen && npm run seed:write-photo && npm run seed:speak",
    "seed:append": "tsx scripts/seed/append.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@prisma/client": "^6.19.3",
    "@smnasiruz016-blip/almi-data": "^0.5.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "an-array-of-english-words": "^2.0.0",
    "most-common-words-by-language": "^3.0.14",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
